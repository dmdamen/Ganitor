{
    "app-id": "io.github.dmdamen.Ganitor",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "ganitor",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=xdg-data/Trash:create"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/share/vala",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "ganitor",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/dmdamen/Ganitor.git",
                    "tag": "v0.1.0",
                    "commit": "41e3dbd080522a96fdf33819a7bbff38ddff5fd7"
                }
            ]
        }
    ]
}
